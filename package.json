{
  "name": "envguard-lite",
  "version": "0.1.0",
  "description": "A lightweight, beginner-friendly Node.js utility package for validating environment variables and providing clear configuration errors.",
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsc --project tsconfig.json",
    "test:example": "node --test test/example.test.js",
    "example": "node examples/server.js"
  },
  "keywords": [
    "env",
    "environment",
    "variables",
    "validation"
  ],
  "files": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "examples",
    "README.md",
    "package.json"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
